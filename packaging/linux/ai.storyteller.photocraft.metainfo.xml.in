<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). The id stays the upstream app id: it must
     match the window's app_id (APP_ID in apps/photocraft/src/main.rs), which also names the
     folder where the editor keeps its window state. Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.photocraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>PhotoHouse</name>
  <summary>Edit photos and layered PSD documents</summary>
  <developer id="br.com.house">
    <name>House de Criatividade</name>
  </developer>
  <description>
    <p>
      PhotoHouse is an open-source, native image editor with the familiar menus,
      shortcuts, panels and tools professionals expect: layers, masks, adjustment
      layers, layer styles, type and brushes.
    </p>
    <ul>
      <li>Open, edit and save layered PSD and PSB files</li>
      <li>8-bit, 16-bit and 32-bit float documents in RGB, grayscale, CMYK and Lab</li>
      <li>A GPU compositor with multithreaded filters</li>
      <li>Every action is a command, scriptable from a CLI, a JSON control channel and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.photocraft.desktop</launchable>
  <icon type="stock">ai.storyteller.photocraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/HOUSE-DE-CRIATIVIDADE/PhotoHouse</url>
  <url type="bugtracker">https://github.com/HOUSE-DE-CRIATIVIDADE/PhotoHouse/issues</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>photocraft</binary>
    <mediatype>application/x-photocraft</mediatype>
    <mediatype>image/x-paintnet</mediatype>
    <mediatype>image/openraster</mediatype>
    <mediatype>application/x-krita</mediatype>
    <mediatype>image/vnd.adobe.photoshop</mediatype>
    <mediatype>image/x-psb</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
